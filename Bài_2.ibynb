    {
      "cell_type": "code",
      "source": [
        "import shutil\n",
        "import os\n",
        "\n",
        "src_path = '/kc_house_data.csv'\n",
        "dest_path = '/content/kc_house_data.csv'\n",
        "\n",
        "if os.path.exists(src_path):\n",
        "    shutil.move(src_path, dest_path)\n",
        "    print(\"Đã di chuyển file kc_house_data.csv vào thư mục /content thành công!\")\n",
        "elif os.path.exists(dest_path):\n",
        "    print(\"File kc_house_data.csv đã nằm đúng vị trí trong /content!\")\n",
        "else:\n",
        "    print(\"Vẫn không tìm thấy file. Đang tự động tải bộ dữ liệu trực tuyến...\")\n",
        "    import urllib.request\n",
        "    url = 'https://raw.githubusercontent.com/man-c/house_prices_prediction/master/kc_house_data.csv'\n",
        "    urllib.request.urlretrieve(url, dest_path)\n",
        "    print(\"Đã tải thành công file mới về thư mục /content!\")\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import seaborn as sns  # Thêm thư viện seaborn để vẽ boxplot đẹp hơn\n",
        "from sklearn.ensemble import GradientBoostingRegressor, RandomForestRegressor\n",
        "from sklearn.linear_model import LinearRegression, Ridge\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.tree import DecisionTreeRegressor\n",
        "\n",
        "# Cấu hình hiển thị đầy đủ các cột của pandas\n",
        "pd.set_option(\"display.max_columns\", None)\n",
        "\n",
        "# ==============================================================================\n",
        "# BƯỚC 1: NẠP VÀ KIỂM TRA CẤU TRÚC DỮ LIỆU (EDA CƠ BẢN)\n",
        "# ==============================================================================\n",
        "df_kc = pd.read_csv(\"kc_house_data.csv\")\n",
        "print(f\"-> Đã nạp thành công bộ dữ liệu! Kích thước: {df_kc.shape}\")\n",
        "\n",
        "print(\"=== KIỂM TRA CẤU TRÚC DỮ LIỆU ===\")\n",
        "print(\"Shape:\", df_kc.shape)\n",
        "print(\"\\nKiểu dữ liệu:\")\n",
        "print(df_kc.dtypes)\n",
        "print(\"\\nSố giá trị thiếu:\", df_kc.isnull().sum().sum())\n",
        "print(\"Số dòng trùng lặp:\", df_kc.duplicated().sum())\n",
        "\n",
        "# Loại bỏ các cột không dùng trực tiếp để dự đoán (id, date)\n",
        "df_clean = df_kc.drop(columns=[\"id\", \"date\"], errors=\"ignore\")\n",
        "\n",
        "# ==============================================================================\n",
        "# BƯỚC 2: KHÁM PHÁ DỮ LIỆU NÂNG CAO (EDA - THỐNG KÊ & TRỰC QUAN HÓA)\n",
        "# ==============================================================================\n",
        "print(\"\\n=================== THỐNG KÊ MÔ TẢ ===================\")\n",
        "display(df_clean.describe().T)\n",
        "\n",
        "# 1. TRỰC QUAN HÓA PHÂN PHỐI (HISTOGRAM)\n",
        "print(\"\\n--- Đang vẽ biểu đồ phân phối các biến ---\")\n",
        "sample_cols = [\"price\", \"bedrooms\", \"bathrooms\", \"sqft_living\", \"grade\", \"yr_built\"]\n",
        "\n",
        "plt.figure(figsize=(15, 10))\n",
        "for i, col in enumerate(sample_cols):\n",
        "    plt.subplot(2, 3, i + 1)\n",
        "    plt.hist(df_clean[col], bins=30, color=\"skyblue\", edgecolor=\"black\", alpha=0.7)\n",
        "    plt.title(f\"Phân phối: {col}\", fontsize=12)\n",
        "    plt.xlabel(col)\n",
        "    plt.ylabel(\"Tần suất\")\n",
        "    plt.grid(alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 2. BỔ SUNG: VẼ BIỂU ĐỒ BOXPLOT ĐỂ PHÁT HIỆN NGOẠI LỆ (OUTLIERS)\n",
        "print(\"\\n--- Đang vẽ biểu đồ Boxplot để kiểm tra ngoại lệ ---\")\n",
        "outlier_cols = [\"price\", \"sqft_living\", \"bathrooms\", \"sqft_lot\"]\n",
        "\n",
        "plt.figure(figsize=(14, 6))\n",
        "for i, col in enumerate(outlier_cols):\n",
        "    plt.subplot(2, 2, i + 1)\n",
        "    sns.boxplot(x=df_clean[col], color=\"orange\")\n",
        "    plt.title(f\"Boxplot ngoại lệ: {col}\", fontsize=12)\n",
        "    plt.xlabel(col)\n",
        "    plt.grid(alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 3. MA TRẬN TƯƠNG QUAN DẠNG BẢNG SỐ LIỆU\n",
        "print(\"\\n=================== MA TRẬN TƯƠNG QUAN (BẢNG) ===================\")\n",
        "corr = df_clean.corr(numeric_only=True)\n",
        "target_corr = (\n",
        "    corr[\"price\"].drop(\"price\").sort_values(key=np.abs, ascending=False)\n",
        ")\n",
        "print(\"Tương quan giữa các đặc trưng với giá nhà (price):\")\n",
        "display(target_corr.to_frame(\"corr_with_price\"))\n",
        "\n",
        "# ==============================================================================\n",
        "# BƯỚC 3: TẠO ĐẶC TRƯNG MỚI (FEATURE ENGINEERING)\n",
        "# ==============================================================================\n",
        "df_clean[\"house_age\"] = 2015 - df_clean[\"yr_built\"]\n",
        "df_clean[\"is_renovated\"] = (df_clean[\"yr_renovated\"] > 0).astype(int)\n",
        "df_clean[\"living_lot_ratio\"] = df_clean[\"sqft_living\"] / (\n",
        "    df_clean[\"sqft_lot\"] + 1\n",
        ")\n",
        "df_clean[\"total_sqft\"] = df_clean[\"sqft_above\"] + df_clean[\"sqft_basement\"]\n",
        "\n",
        "# ==============================================================================\n",
        "# BƯỚC 4: XÁC ĐỊNH CÁC KỊCH BẢN TẬP ĐẶC TRƯNG (FEATURE SELECTION)\n",
        "# ==============================================================================\n",
        "X_full = df_clean.drop(columns=[\"price\"])\n",
        "y = df_clean[\"price\"]\n",
        "\n",
        "top_corr_features = (\n",
        "    df_clean.corr()[\"price\"]\n",
        "    .drop(\"price\")\n",
        "    .abs()\n",
        "    .sort_values(ascending=False)\n",
        "    .head(8)\n",
        "    .index.tolist()\n",
        ")\n",
        "\n",
        "feature_sets = {\n",
        "    \"1. Baseline (Cơ bản)\": [\n",
        "        \"bedrooms\",\n",
        "        \"bathrooms\",\n",
        "        \"sqft_living\",\n",
        "        \"floors\",\n",
        "    ],\n",
        "    \"2. Feature Engineering (Đầy đủ)\": X_full.columns.tolist(),\n",
        "    \"3. Feature Selection (Top 8 Corr)\": top_corr_features,\n",
        "}\n",
        "\n",
        "# ==============================================================================\n",
        "# BƯỚC 5: HUẤN LUYỆN VÀ ĐÁNH GIÁ PIPELINE ĐA MÔ HÌNH\n",
        "# ==============================================================================\n",
        "models = {\n",
        "    \"Linear Regression\": LinearRegression(),\n",
        "    \"Ridge Regression\": Ridge(alpha=100.0, random_state=42),\n",
        "    \"Decision Tree\": DecisionTreeRegressor(max_depth=6, random_state=42),\n",
        "    \"Random Forest\": RandomForestRegressor(\n",
        "        n_estimators=100, max_depth=10, random_state=42, n_jobs=-1\n",
        "    ),\n",
        "    \"Gradient Boosting\": GradientBoostingRegressor(\n",
        "        n_estimators=100, max_depth=5, random_state=42\n",
        "    ),\n",
        "}\n",
        "\n",
        "all_results = []\n",
        "\n",
        "for feat_name, feat_cols in feature_sets.items():\n",
        "  X_subset = df_clean[feat_cols]\n",
        "  X_train, X_test, y_train, y_test = train_test_split(\n",
        "      X_subset, y, test_size=0.2, random_state=42\n",
        "  )\n",
        "\n",
        "  scaler = StandardScaler()\n",
        "  X_train_scaled = scaler.fit_transform(X_train)\n",
        "  X_test_scaled = scaler.transform(X_test)\n",
        "\n",
        "  for model_name, model in models.items():\n",
        "    model.fit(X_train_scaled, y_train)\n",
        "    y_pred = model.predict(X_test_scaled)\n",
        "\n",
        "    mae = mean_absolute_error(y_test, y_pred)\n",
        "    rmse = np.sqrt(mean_squared_error(y_test, y_pred))\n",
        "    r2 = r2_score(y_test, y_pred)\n",
        "\n",
        "    all_results.append({\n",
        "        \"Kịch bản Feature\": feat_name,\n",
        "        \"Mô hình\": model_name,\n",
        "        \"MAE\": round(mae, 2),\n",
        "        \"RMSE\": round(rmse, 2),\n",
        "        \"R² Score\": round(r2, 4),\n",
        "    })\n",
        "\n",
        "df_final_results = pd.DataFrame(all_results).sort_values(\n",
        "    by=\"R² Score\", ascending=False\n",
        ")\n",
        "print(\"\\n=================== BẢNG SO SÁNH HIỆU NĂNG ===================\")\n",
        "display(df_final_results.reset_index(drop=True))"
      ],
