      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "from sklearn.datasets import load_diabetes\n",
        "\n",
        "# 1. Load dữ liệu\n",
        "diabetes = load_diabetes()\n",
        "\n",
        "X = pd.DataFrame(diabetes.data, columns=diabetes.feature_names)\n",
        "y = pd.Series(diabetes.target, name=\"target\")\n",
        "\n",
        "# Chọn 3 feature\n",
        "features = [\"bmi\", \"bp\", \"s5\"]\n",
        "\n",
        "# 2. Histogram\n",
        "X[features].hist(figsize=(10, 5), bins=20)\n",
        "plt.suptitle(\"Histogram of 3 Features\")\n",
        "plt.show()\n",
        "\n",
        "# 3. Boxplot\n",
        "plt.figure(figsize=(8, 5))\n",
        "X[features].boxplot()\n",
        "plt.title(\"Boxplot of 3 Features\")\n",
        "plt.ylabel(\"Value\")\n",
        "plt.show()\n",
        "\n",
        "# 4. Correlation với target\n",
        "correlation = X[features].corrwith(y)\n",
        "\n",
        "print(\"Correlation với target:\")\n",
        "print(correlation)\n",
        "\n",
        "correlation.plot(kind=\"bar\", figsize=(7, 5))\n",
        "plt.title(\"Correlation with Target\")\n",
        "plt.ylabel(\"Correlation\")\n",
        "plt.axhline(0, color=\"black\", linewidth=0.8)\n",
        "plt.show()\n",
        "\n",
        "# 5. Scatter plot: từng feature với target\n",
        "for feature in features:\n",
        "    plt.figure(figsize=(6, 4))\n",
        "    plt.scatter(X[feature], y)\n",
        "    plt.xlabel(feature)\n",
        "    plt.ylabel(\"Target\")\n",
        "    plt.title(f\"{feature} vs Target\")\n",
        "    plt.show()"
      ],
